<!-- FOOTER -->
<footer class="footer">
  <div class="container footer-grid">
    <!-- Col 1: Brand -->
    <div class="footer-col brand-col">
      <div class="brand-logo footer-logo">
        <div class="brand-symbol">
          <span class="material-symbols-outlined">science</span>
        </div>
        <div class="brand-text">
          <span class="brand-title">{{ section.settings.footer_title }}</span>
          <span class="brand-subtitle">{{ section.settings.footer_subtitle }}</span>
        </div>
      </div>
      <p class="footer-desc">
        {{ section.settings.footer_desc }}
      </p>
      <div class="footer-cert-badges">
        <span class="cert-tag"><span class="material-symbols-outlined icon-sm">verified</span> cGMP Certified</span>
        <span class="cert-tag"><span class="material-symbols-outlined icon-sm">eco</span> Cruelty Free</span>
        <span class="cert-tag"><span class="material-symbols-outlined icon-sm">medical_services</span> Derm Tested</span>
      </div>
    </div>

    <!-- Col 2: Products -->
    <div class="footer-col">
      <h4 class="footer-heading">Clinical Range</h4>
      <ul class="footer-links">
        <li><a href="#shop">Oil Free Moisturizer SPF 20</a></li>
        <li><a href="#shop">Hydrating Ceramide Cream</a></li>
        <li><a href="#shop">Ultra-Gentle Foaming Cleanser</a></li>
        <li><a href="#shop">Sun Defense SPF 50+ Fluid</a></li>
        <li><a href="#shop">Niacinamide 10% + Zinc Serum</a></li>
      </ul>
    </div>

    <!-- Col 3: Support -->
    <div class="footer-col">
      <h4 class="footer-heading">Patient & Client Care</h4>
      <ul class="footer-links">
        <li><a href="#faq">Clinical FAQ</a></li>
        <li><a href="#routine-builder">Skin Diagnostic Quiz</a></li>
        <li><a href="#">Track Your Delivery</a></li>
        <li><a href="#">Return & Refund Policy</a></li>
        <li><a href="#">Pharmacist Consultation</a></li>
      </ul>
    </div>

    <!-- Col 4: Contact & Social -->
    <div class="footer-col">
      <h4 class="footer-heading">Connect With Us</h4>
      <p class="footer-contact-item">
        <span class="material-symbols-outlined">call</span>
        <span>{{ section.settings.phone }}</span>
      </p>
      <p class="footer-contact-item">
        <span class="material-symbols-outlined">mail</span>
        <span>{{ section.settings.email }}</span>
      </p>
      <div class="social-links">
        <a href="#" class="social-icon-btn" aria-label="Website"><span class="material-symbols-outlined">public</span></a>
        <a href="#" class="social-icon-btn" aria-label="Email"><span class="material-symbols-outlined">mail</span></a>
        <a href="#" class="social-icon-btn" aria-label="Share"><span class="material-symbols-outlined">share</span></a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-flex">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Clinical Grade Skincare. All Rights Reserved.</p>
      <div class="footer-legal-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Quality Assurance</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_title",
      "label": "Footer Logo Title",
      "default": "Jenpharm Dermive"
    },
    {
      "type": "text",
      "id": "footer_subtitle",
      "label": "Footer Subtitle",
      "default": "Clinical Precision Skincare"
    },
    {
      "type": "textarea",
      "id": "footer_desc",
      "label": "Footer Description",
      "default": "Professional-grade dermaceutical solutions backed by molecular research and clinical trials. Ethical, pure, fragrance-free, and cruelty-free."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "0800-DERMIVE (0800-3376483)"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support Email",
      "default": "care@jenpharmdermive.com"
    }
  ]
}
{% endschema %}
